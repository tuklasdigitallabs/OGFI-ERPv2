# Non-production preview only. Append as exact-host server blocks to the existing
# shared edge after replacing the certificate and Basic Auth file paths.
server {
    listen 80;
    server_name staging-erp.onegourmetph.com;

    location ^~ /.well-known/acme-challenge/ {
        root /etc/nginx/certs;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name staging-erp.onegourmetph.com;

    ssl_certificate /etc/nginx/certs/staging-erp.onegourmetph.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/staging-erp.onegourmetph.com/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;

    auth_basic "OGFI ERP work-in-progress preview";
    auth_basic_user_file /etc/nginx/snippets/staging-erp.htpasswd;
    client_max_body_size 27m;

    location / {
        proxy_pass http://staging_erp_web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
}
