# Rendered host-level Nginx server block for the shared VPS.
# Replace only the marked deployment values during the controlled install.
# This file intentionally has no default_server and no wildcard server_name.

upstream ogfi_caddy_loopback {
    server 127.0.0.1:OGFI_CADDY_HTTP_PORT;
    keepalive 16;
}

server {
    listen 443 ssl http2;
    server_name OGFI_EXACT_HOSTNAME;

    ssl_certificate     /etc/letsencrypt/live/OGFI_EXACT_HOSTNAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/OGFI_EXACT_HOSTNAME/privkey.pem;

    client_max_body_size 27m;
    proxy_http_version 1.1;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Forwarded "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_pass_header X-OGFI-Proxy-Fence;

    location / {
        proxy_pass http://ogfi_caddy_loopback;
    }
}
