FROM docker.io/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

ARG RELEASE_COMMIT_SHA
ARG EDGE_CONFIG_SHA256
LABEL org.opencontainers.image.revision="${RELEASE_COMMIT_SHA}" \
      io.ogfi.local-uat-edge-config.sha256="${EDGE_CONFIG_SHA256}"

COPY local-uat-nginx.conf /etc/nginx/nginx.conf

USER 101:101
ENTRYPOINT ["nginx", "-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
