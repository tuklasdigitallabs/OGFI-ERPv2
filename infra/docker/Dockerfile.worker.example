ARG NODE_VERSION=22
FROM node:${NODE_VERSION}-alpine AS base
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile
COPY packages/database/prisma packages/database/prisma
RUN pnpm --filter @ogfi/database generate
COPY . .
ARG WORKER_BUILD_NODE_OPTIONS=--max-old-space-size=4096
RUN NODE_OPTIONS="${WORKER_BUILD_NODE_OPTIONS}" pnpm --filter @ogfi/worker build
RUN addgroup -S ogfi && adduser -S ogfi -G ogfi && chown -R ogfi:ogfi /app
USER ogfi
CMD ["pnpm", "--filter", "@ogfi/worker", "start"]
