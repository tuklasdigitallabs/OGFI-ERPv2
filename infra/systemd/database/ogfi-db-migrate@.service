[Unit]
Description=DISABLED — migrations run only inside the fenced OGFI release session
Documentation=file:/opt/ogfi/current/infra/systemd/database/README.md
RefuseManualStart=yes
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/usr/bin/false

# Do not install or grant sudo access to this legacy compatibility tombstone.
# The root-owned release-session orchestrator is the only supported migration
# admission path, so a standalone unit cannot overlap snapshot or cutover.
